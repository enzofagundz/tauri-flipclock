{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flipclock",
  "version": "0.2.0",
  "identifier": "io.github.enzofagundz.flipclock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flipclock",
        "width": 464,
        "height": 168,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../src/assets/fonts/OFL.txt": "licenses/Roboto-Condensed-OFL.txt"
    },
    "linux": {
      "rpm": {
        "depends": ["gtk-layer-shell"]
      }
    }
  }
}
